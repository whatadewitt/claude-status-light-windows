<Window x:Class="StatusLight.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude Status Light Settings"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        FontSize="12">
    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <!-- No implicit (un-keyed) styles here: one without BasedOn replaces the Fluent theme's
             style for that control, which reverts it to the classic look (black text in dark mode).
             Margins are set per control instead. -->
    </Window.Resources>
    <StackPanel Margin="20" MinWidth="340">
        <TextBlock Text="Floating window" Style="{StaticResource Section}" />
        <CheckBox x:Name="ShowFloatingBox" Margin="0,0,0,8" Content="Show floating window" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <CheckBox x:Name="LockToCornerBox" Content="Lock to corner" Margin="0"
                      VerticalAlignment="Center" />
            <ComboBox x:Name="CornerBox" Margin="10,0,0,0" MinWidth="120" />
        </StackPanel>
        <CheckBox x:Name="AutoHideBox" Margin="0,0,0,8" Content="Auto-hide — show only the mascot until hovered" />

        <Separator Margin="0,4,0,10" />
        <TextBlock Text="Behavior" Style="{StaticResource Section}" />
        <CheckBox x:Name="GreenBeatsYellowBox" Margin="0,0,0,8" Content="Done beats busy (green outranks yellow)" />
        <CheckBox x:Name="StartAtLoginBox" Margin="0,0,0,8" Content="Start at login" />

        <Separator Margin="0,4,0,10" />
        <TextBlock Text="Icon" Style="{StaticResource Section}" />
        <TextBlock TextWrapping="Wrap" MaxWidth="340" Margin="0,0,0,8"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="Drop an image at %USERPROFILE%\.claude\status-light\icon.png to use it as the icon; a colored status dot is added automatically." />
        <Button x:Name="RevealIconButton" Content="Reveal icon folder…" HorizontalAlignment="Left"
                Padding="10,3" />
    </StackPanel>
</Window>
